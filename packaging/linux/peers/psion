# PsionNet: the PPP link to a Psion Series 5mx, 7, netBook or Revo over the
# serial cable. The Debian version of etc/ppp/peers/psion.
#
# PsionNet starts it as
#
#     pppd call psion /dev/ttyUSB0 logfile ~/.local/state/psionnet/ppp.log
#
# with the port you picked. The device and the log are given on the command
# line, not here: a user in the groups dip and dialout runs Debian's pppd with
# no password, and pppd then opens both with that user's rights. The options
# below that need root (noauth among them) are allowed because this file is
# root's.
115200

# this computer : Psion
10.0.2.1:10.0.2.2

# Handed to the Psion over IPCP. Requires "Get DNS address from server"
# ticked on the Psion's Internet service > Addresses page.
ms-dns 1.1.1.1
ms-dns 9.9.9.9

noauth          # the Psion is the only thing that can reach this cable
passive         # send one LCP Configure-Request, then wait for the Psion
local           # ignore DCD: the Psion cable leaves DB9 pin 1 unconnected
nodetach        # stay in the foreground; PsionNet stops it with a signal
nodefaultroute  # never route this computer's own traffic down the cable
ipparam psionnet # /etc/ppp/ip-up.d/psionnet acts on this link and no other
crtscts         # RTS/CTS are wired through on the Psion's cable
asyncmap 0      # clean 8-bit path, nothing needs escaping
mtu 1500
mru 1500
lcp-echo-interval 30
lcp-echo-failure 4
debug
