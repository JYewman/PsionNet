<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- CPython generates and executes code at runtime, so the hardened runtime
       needs these two or the app crashes on launch once notarised. -->
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key><true/>
  <key>com.apple.security.cs.allow-jit</key><true/>
  <!-- PyInstaller ships many .so files signed with our own identity rather
       than Apple's, which library validation would otherwise reject. -->
  <key>com.apple.security.cs.disable-library-validation</key><true/>
  <!-- pppd is launched through osascript, which counts as sending an Apple event. -->
  <key>com.apple.security.automation.apple-events</key><true/>
</dict>
</plist>
